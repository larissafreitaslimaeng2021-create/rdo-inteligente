rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // TEST CONNECTION
    match /test/{testId} {
      allow read, write: if true;
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // COMPANIES COLLECTION
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(companyId);
    }

    // OBRAS COLLECTION
    match /obras/{obraId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(obraId);
    }

    // TEAM MEMBERS COLLECTION
    match /teamMembers/{memberId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(memberId);
    }

    // RDOS COLLECTION
    match /rdos/{rdoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(rdoId);
    }

    // DOCUMENTS COLLECTION
    match /documents/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(docId);
    }
  }
}
